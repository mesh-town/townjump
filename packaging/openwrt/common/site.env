# Where the package feeds are served from; read by the build and publish scripts.
# Three separate repositories, each with its own Pages site and its own deploy key.
PAGES_BRANCH=main
# dist: releases, direct downloads and the apt repository (served under linux/debian)
DIST_PAGES_URL=https://mesh-town.github.io/townjump-dist
DIST_GIT_URL=git@github.com:mesh-town/townjump-dist.git
# OpenWrt feed (install.sh in the repository root)
OPENWRT_PAGES_URL=https://mesh-town.github.io/townjump-openwrt
OPENWRT_GIT_URL=git@github.com:mesh-town/townjump-openwrt.git
# Keenetic feed (install.sh in the repository root)
KEENETIC_PAGES_URL=https://mesh-town.github.io/townjump-keenetic
KEENETIC_GIT_URL=git@github.com:mesh-town/townjump-keenetic.git
